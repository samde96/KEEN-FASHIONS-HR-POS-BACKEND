# Copy to .env for local development. Real .env files are ignored by Git.
# On Render, set environment variables in the dashboard instead of uploading .env.
FASHIONPOS_DB_URL=jdbc:postgresql://localhost:5432/fashion_pos
FASHIONPOS_DB_USERNAME=fashion_pos_app
FASHIONPOS_DB_PASSWORD=change-me-local-only

FASHIONPOS_ADMIN_EMAIL=admin@example.com
FASHIONPOS_ADMIN_PASSWORD=change-this-admin-password
FASHIONPOS_ADMIN_DISPLAY_NAME=System Admin
FASHIONPOS_ORGANIZATION_NAME=KEEN Fashions
FASHIONPOS_CURRENCY_CODE=KES
FASHIONPOS_TIME_ZONE=Africa/Nairobi

FASHIONPOS_CORS_ALLOWED_ORIGINS=http://localhost:5173
FASHIONPOS_SESSION_TIMEOUT=30m
FASHIONPOS_SESSION_COOKIE_SECURE=false
FASHIONPOS_SESSION_COOKIE_SAME_SITE=lax
FASHIONPOS_LOGIN_RATE_LIMIT_ENABLED=true
FASHIONPOS_LOGIN_MAX_FAILED_ATTEMPTS=5
FASHIONPOS_LOGIN_RATE_LIMIT_WINDOW=15m
FASHIONPOS_LOGIN_RATE_LIMIT_LOCKOUT=15m

# Optional manager login: configure both values to enable it.
FASHIONPOS_MANAGER_EMAIL=
FASHIONPOS_MANAGER_PASSWORD=

# Email copies of system notifications and daily summaries. Use a verified Resend sender.
FASHIONPOS_DAILY_SUMMARY_SCHEDULER_ENABLED=true
FASHIONPOS_NOTIFICATION_EMAIL_SCHEDULER_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional M-Pesa integration. Keep all payment credentials on the backend.
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_ORGANIZATION_ID=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS backend origin without a path or trailing slash.
MPESA_CALLBACK_BASE_URL=
# Separate random secret (32+ characters) and base64-encoded 32-byte AES key.
MPESA_CALLBACK_SECRET_KEY=
MPESA_ENCRYPTION_KEY=
# Leave unset to use application defaults; verify provider IPs before live use.
# MPESA_CALLBACK_ALLOWED_IPS=
# Configure only proxy IPs/CIDRs trusted for your hosting ingress.
MPESA_TRUSTED_PROXIES=
